# Configure as server-side secrets/bindings in the hosting environment.
# IMAGE_API_KEY takes precedence when both key fields exist.
OPENAI_API_KEY=
IMAGE_API_KEY=
# 97API newapi direct endpoint. Do not append /images/generations or /images/edits.
IMAGE_API_BASE_URL=https://new-nocf.97api.com/v1
# Explicit model configuration is required before generation is enabled.
IMAGE_MODEL=gpt-image-2

# Qwen3 TTS uses an Alibaba Cloud Model Studio API key from the Beijing region.
DASHSCOPE_API_KEY=
QWEN_TTS_MODEL=qwen3-tts-instruct-flash
QWEN_TTS_FEMALE_VOICE=Momo
QWEN_TTS_MALE_VOICE=Moon

# Storyboard generation (story -> shots) reuses DASHSCOPE_API_KEY via the
# OpenAI-compatible endpoint. Optional; defaults shown.
STORYBOARD_LLM_MODEL=qwen3.8-flash
STORYBOARD_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Enable only when the app is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY=0
