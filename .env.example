# Configure as server-side secrets/bindings in the hosting environment.
# Use IMAGE_API_KEY for another compatible provider; it takes precedence when both keys exist.
OPENAI_API_KEY=
# IMAGE_API_KEY=
# An OpenAI-compatible Images API base URL. Defaults to https://api.openai.com/v1.
IMAGE_API_BASE_URL=https://api.openai.com/v1
# Explicit model configuration is required before generation is enabled.
IMAGE_MODEL=gpt-image-2.5-flare
